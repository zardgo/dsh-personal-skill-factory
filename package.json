{
  "name": "dsh-personal-skill-factory",
  "version": "0.3.6",
  "private": true,
  "description": "Skill Factory - DSH personal workbench for traceable Agent Skill document ingestion, DSH model generation and real evaluation",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "assets"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1 <0.3.4-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1 <0.3.4-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.1 <0.3.4-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.1 <0.3.4-0",
    "react": "^18.2.0"
  }
}
